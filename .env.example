# ==========================================
# DRISHTI Environment Configuration Example
# ==========================================

# Backend Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://drishti-app.vercel.app

# Google Gemini API Key (Required for backend AI lesson generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="[GCP_API_KEY]"

# Tesseract OCR Command Path (Optional, defaults to system 'tesseract')
# On Windows, e.g.: C:\Program Files\Tesseract-OCR\tesseract.exe
# In Docker / Linux, defaults to: tesseract
TESSERACT_CMD=tesseract

# Frontend Configuration
# VITE_API_URL=http://localhost:8000
