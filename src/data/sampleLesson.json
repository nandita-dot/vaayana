  "passage": [
    {
      "id": "s1",
      "text": "In the quiet morning, a small sparrow hopped along the garden path.",
      "vocabRefs": ["v-sparrow", "v-garden"]
    },
    {
      "id": "s2",
      "text": "She pecked at tiny seeds that had fallen near the marigold flowers.",
      "vocabRefs": ["v-seeds"]
    },
    {
      "id": "s3",
      "text": "A gentle breeze rustled the leaves, and the sparrow paused to listen.",
      "vocabRefs": ["v-sparrow"]
    },
    {
      "id": "s4",
      "text": "Then she fluttered up to a low branch and sang a short, happy song.",
      "vocabRefs": ["v-fluttered"]
    },
    {
      "id": "s5",
      "text": "The children watching from the window smiled at their little visitor.",
      "vocabRefs": []
    }
  ],
